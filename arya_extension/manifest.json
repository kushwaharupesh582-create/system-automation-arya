{
    "manifest_version": 3,
    "name": "Arya Controller",
    "version": "1.0.0",
    "description": "Controls browser tabs via Arya AI voice assistant",
    "permissions": ["tabs", "activeTab"],
    "host_permissions": [
        "http://localhost:5000/*",
        "http://127.0.0.1:5000/*"
    ],
    "background": {
        "service_worker": "background.js"
    }
}